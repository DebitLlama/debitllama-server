{
  "lock": false,
  "tasks": {
    "start": "ENV=development deno run -A --unstable-kv --watch=static/,routes/ dev.ts",
    "update": "deno run -A -r https://fresh.deno.dev/update .",
    "test_enc": "deno test tests/encryption.ts",
    "test_queryFilter": "deno run -A tests/queryFilter.ts --allow-net",
    "livetest_paymentIntentResetting": "deno run -A tests/paymentIntentResetting.ts --allow-net",
    "livetest_queryBuilderTests": "deno run -A tests/queryBuilderTests.ts --allow-net",
    "test_v1": "deno test -A tests/apiv1/index.ts",
    "test_accounts": "deno test -A tests/apiv1/accounts.ts",
    "test_accountslug": "deno test -A tests/apiv1/accountslug.ts",
    "test_paymentIntents": "deno test -A tests/apiv1/payment_intents.ts",
    "test_paymentIntentslug": "deno test -A tests/apiv1/payment_intentslug.ts",
    "test_items": "deno test -A tests/apiv1/items.ts",
    "test_zapier_webhooks": "deno test -A tests/apiv1/zapier_webhooks.ts",
    "main": "deno run -A --unstable-kv main.ts",
    "build": "RELAYERAUTHTOKEN=asd SLACKFEEDBACKSURL=asd SLACKUSERSIGNUPS=asd USER_FEEDBACKS_WEBHOOK=asd SMTP_HOSTNAME=asd SMTP_USERNAME=asd SMTP_PASSWORD=asd TESTACCESSTOKEN=asd SUPABASE_URL=asf SUPABASE_KEY=asd ETHENCRYPTPUBLICKEY=asf ETHENCRYPTPRIVATEKEY=sad SALESTEAMEMAILADDRESS=asd deno run -A --unstable-kv dev.ts build",
    "preview": "deno run -A main.ts",
    "redeploy": "bash redeploy.sh"
  },
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.2/",
    "preact": "https://esm.sh/preact@10.29.8",
    "preact/": "https://esm.sh/preact@10.29.8/",
    "preact-render-to-string": "https://esm.sh/*preact-render-to-string@6.7.0",
    "@preact/signals": "https://esm.sh/*@preact/signals@2.11.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.14.4",
    "twind": "https://esm.sh/twind@0.16.19",
    "twind/": "https://esm.sh/twind@0.16.19/",
    "$std/": "https://deno.land/std@0.224.0/",
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.115.0",
    "$ethers": "https://esm.sh/ethers@6.17.0",
    "@metamask/eth-sig-util": "https://esm.sh/@metamask/eth-sig-util@9.0.0",
    "buffer": "node:buffer",
    "screen-size-detector": "https://esm.sh/screen-size-detector@1.0.4",
    "jose": "https://esm.sh/jose@6.2.11",
    "@simplewebauthn/browser": "https://esm.sh/@simplewebauthn/browser@14.0.0",
    "@simplewebauthn/server": "https://esm.sh/@simplewebauthn/server@14.0.0",
    "@twind/core": "https://esm.sh/@twind/core@1.1.3",
    "@twind/preset-tailwind": "https://esm.sh/@twind/preset-tailwind@1.1.4/",
    "@twind/preset-autoprefix": "https://esm.sh/@twind/preset-autoprefix@1.0.7/",
    "react-typed": "https://esm.sh/react-typed@2.0.12",
    "captcha": "https://deno.land/x/svg_captcha@v1.1.0/mod.ts",
    "$turnstile/": "https://deno.land/x/fresh_turnstile@1.0.1-0/"
  },
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"]
}